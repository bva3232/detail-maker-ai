# OpenAI API 키 (필수) — https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY=sk-여기에_본인_키

# (선택) 카피 생성 모델. 기본값 gpt-4o-mini
# COPY_MODEL=gpt-4o-mini

# (선택) 이미지 모델. 기본 gpt-image-1.
# 조직 인증이 안 돼 gpt-image-1 이 막히면 아래 줄의 주석을 풀어 dall-e-3 사용
# IMAGE_MODEL=dall-e-3

# (선택) 이미지 크기 / 품질
# IMAGE_SIZE=1024x1024
# IMAGE_QUALITY=high
