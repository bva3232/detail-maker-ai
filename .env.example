# 이 앱은 무료 Pollinations.ai 를 사용하므로 API 키가 필요 없습니다.
# 아래는 전부 선택 사항입니다. 그냥 배포해도 동작합니다.

# (선택) 사용 한도를 늘리고 싶을 때만: https://auth.pollinations.ai 에서 발급
# POLLINATIONS_TOKEN=

# (선택) 카피 생성 모델 (기본 openai)
# TEXT_MODEL=openai

# (선택) 이미지 모델 / 크기 (기본 flux, 1024x1024)
# IMAGE_MODEL=flux
# IMAGE_WIDTH=1024
# IMAGE_HEIGHT=1024
